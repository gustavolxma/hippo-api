# Copie este arquivo para ".env" (cp .env.example .env) e preencha os valores.
# O .env fica só no servidor: ele está no .gitignore e NUNCA deve ir para o Git.

# Domínio apontado para o IP do servidor (DuckDNS). O Caddy gera o HTTPS para ele.
DOMINIO=hippo-api.duckdns.org

# Senha do banco PostgreSQL (invente uma senha forte; só a API usa).
DB_PASSWORD=

# Chave que assina os Tokens de acesso. Gere com: openssl rand -base64 48
JWT_SECRET=
# Quantas horas o Token vale antes de o usuário precisar entrar de novo (168 = 7 dias).
JWT_VALIDADE_HORAS=168

# Envio dos Códigos de Verificação por Email (Brevo).
EMAIL_PROVEDOR=brevo
BREVO_API_KEY=
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=Hippo

# Interpretação dos comandos de voz (Google AI Studio).
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-lite-latest
